<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Dokumentations-BPMN för vab: beskriver processens steg för handläggaren. Den körs inte (logiken finns i
  src/main/resources/vab.bpmn). Varje task är ett steg i processvyn: id = stegets id, name = rubrik,
  documentation = beskrivning och metaData "aktivitetId" = aktivitets-ID:n i vab.bpmn som hör till steget.
  processbeskrivning.json ska på sikt genereras från den här filen. Tills dess hålls de lika för hand.
-->
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="vab-processbeskrivning" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:process id="vab" name="Vård av boskap" isExecutable="false" processType="Public">
    <bpmn2:startEvent id="start" name="Start">
      <bpmn2:outgoing>flow-start</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:task id="maskinell-kontroll" name="Maskinell kontroll av rätt till försäkring">
      <bpmn2:documentation>Systemet kontrollerar automatiskt om den försäkrade har rätt till försäkring.</bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="aktivitetId">
          <drools:metaValue>d4ab4820-68d9-41e0-abe1-cd8f9865d275</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>flow-start</bpmn2:incoming>
      <bpmn2:outgoing>flow-maskinell-manuell</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="manuell-kontroll" name="Manuell kontroll av rätt till försäkring">
      <bpmn2:documentation>Handläggaren kompletterar yrkandet vid behov och bedömer rätten till försäkring när den maskinella kontrollen inte räcker.</bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="aktivitetId">
          <drools:metaValue>c58dd666-b3c1-4a30-91b8-76c3495668c6</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>flow-maskinell-manuell</bpmn2:incoming>
      <bpmn2:outgoing>flow-manuell-bekrafta</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="bekrafta-beslut" name="Bekräfta beslut">
      <bpmn2:documentation>Handläggaren bekräftar beslutet innan den försäkrade informeras.</bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="aktivitetId">
          <drools:metaValue>8cde2355-aea5-4951-916f-08319b2f1e99</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>flow-manuell-bekrafta</bpmn2:incoming>
      <bpmn2:outgoing>flow-slut</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:endEvent id="slut" name="Slut">
      <bpmn2:incoming>flow-slut</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="flow-start" sourceRef="start" targetRef="maskinell-kontroll" />
    <bpmn2:sequenceFlow id="flow-maskinell-manuell" sourceRef="maskinell-kontroll" targetRef="manuell-kontroll" />
    <bpmn2:sequenceFlow id="flow-manuell-bekrafta" sourceRef="manuell-kontroll" targetRef="bekrafta-beslut" />
    <bpmn2:sequenceFlow id="flow-slut" sourceRef="bekrafta-beslut" targetRef="slut" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="vab">
      <bpmndi:BPMNShape id="shape-start" bpmnElement="start">
        <dc:Bounds x="100" y="142" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-maskinell-kontroll" bpmnElement="maskinell-kontroll">
        <dc:Bounds x="220" y="120" width="160" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-manuell-kontroll" bpmnElement="manuell-kontroll">
        <dc:Bounds x="440" y="120" width="160" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-bekrafta-beslut" bpmnElement="bekrafta-beslut">
        <dc:Bounds x="660" y="120" width="160" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-slut" bpmnElement="slut">
        <dc:Bounds x="880" y="142" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge-flow-start" bpmnElement="flow-start">
        <di:waypoint x="156" y="170" />
        <di:waypoint x="220" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-flow-maskinell-manuell" bpmnElement="flow-maskinell-manuell">
        <di:waypoint x="380" y="170" />
        <di:waypoint x="440" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-flow-manuell-bekrafta" bpmnElement="flow-manuell-bekrafta">
        <di:waypoint x="600" y="170" />
        <di:waypoint x="660" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-flow-slut" bpmnElement="flow-slut">
        <di:waypoint x="820" y="170" />
        <di:waypoint x="880" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
